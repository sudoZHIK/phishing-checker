{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phishing Checker Analysis Report",
  "type": "object",
  "required": ["schema_version", "risk_score", "risk_level", "coverage", "evidence", "errors"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "risk_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "risk_level": {"enum": ["LOW", "CAUTION", "SUSPICIOUS", "HIGH"]},
    "coverage": {
      "type": "object",
      "required": ["passed", "total", "percent", "status"],
      "properties": {
        "passed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "percent": {"type": "number", "minimum": 0, "maximum": 100},
        "status": {"enum": ["NOT_CHECKED", "PARTIAL", "COMPLETE"]}
      }
    },
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["code", "message", "weight", "severity", "details"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "weight": {"type": "integer", "minimum": 0},
        "severity": {"type": "string"},
        "details": {"type": "object"}
      }
    }
  }
}
